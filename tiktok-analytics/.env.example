# Copia este archivo como .env y rellena con los datos de tu app en developers.tiktok.com.
# .env está en .gitignore: nunca subas el client secret al repositorio.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Debe ser EXACTAMENTE una de las Redirect URI registradas en la app (https, sin parámetros).
TIKTOK_REDIRECT_URI=
# Opcional: quita los permisos que tu app no tenga activados.
# TIKTOK_SCOPES=user.info.basic,user.info.profile,user.info.stats,video.list
